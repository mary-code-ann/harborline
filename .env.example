# Local Postgres started by docker compose. Copy this file to .env.
DATABASE_URL=postgresql+asyncpg://harborline:harborline@localhost:5432/harborline

# Required once the chat agent is running. Leave blank for unit tests.
OPENAI_API_KEY=

# Any chat model that supports structured outputs.
OPENAI_MODEL=gpt-4o-mini

# Which prompts/*.md file the agent loads. agent_v2 is the current procedure.
INSTRUCTION_VERSION=agent_v2
